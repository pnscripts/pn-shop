includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Every migration that builds the schema: the shop's, the core package's base tables,
    # each core module's own, and the bundled plugins'.
    databaseMigrationsPath:
        - database/migrations
        - vendor/pnscripts/pn-shop-core/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Acl/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Api/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Cart/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Catalog/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Cms/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Customer/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Extension/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Installer/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Localization/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Media/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Payment/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Promotion/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Returns/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Sales/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Seo/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Settings/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Shipping/database/migrations
        - vendor/pnscripts/pn-shop-core/src/System/database/migrations
        - vendor/pnscripts/pn-shop-core/src/Tax/database/migrations
        - extensions/pnshop/handling-fee/database/migrations
    stubFiles:
        - stubs/phpstan/kalnoy-nestedset.stub
    paths:
        - app/
        - database/
        - routes/
    level: 5
